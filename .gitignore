**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Release artifacts (built locally)
*.apk
*.aab
*.dmg
*.tar.gz
OrdersApp-*.zip
subTaskManager-*.zip
OrdersApp-*.apk
subTaskManager-*.apk
.flutter-plugins
cloudflare_env.ps1
dist/

# Cloudflare Worker: local state and secrets
worker/.wrangler/
worker/node_modules/
worker/.dev.vars

# Firebase service-account keys. These can push to every user; never commit one.
*adminsdk*.json
*service-account*.json
*serviceAccount*.json

# Local wrangler dev state. cf.json caches the request metadata of the
# machine that ran it - city, postcode, lat/long, ISP - and this repo is public.
.wrangler/

# Android signing. The keystore lives outside the repo; this points at it and
# carries its passwords.
android/key.properties
*.jks
*.p12
*.keystore

# Signing keys of any kind stay outside this repository.
*.pem
